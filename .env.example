# Copy this file to .env and fill it in. Never commit .env (it is in .gitignore).

# ---- Server ----
PORT=3000
# 127.0.0.1 = this computer only. Use 0.0.0.0 only behind an HTTPS reverse proxy.
HOST=127.0.0.1
# Set to "production" when deployed. This turns on Secure cookies and HSTS.
NODE_ENV=development
# true only if a trusted reverse proxy sets X-Forwarded-For (used for login rate limiting).
TRUST_PROXY=false
# Where the SQLite database and the auto-generated secret.key live. Back this folder up.
DATA_DIR=./data
# Optional: a long random string used to encrypt Facebook tokens. If empty, a key is generated in DATA_DIR/secret.key.
# If you lose it, saved Facebook tokens cannot be decrypted (re-enter them).
APP_SECRET=
# Optional: if set, first-time setup requires this value. Recommended when deploying to a public address.
SETUP_TOKEN=

# ---- OpenAI (you provide the key; this app never creates one) ----
OPENAI_API_KEY=
# Pick a model your key can use. In the app: Team & AI > "Check which AI models my key can use".
OPENAI_MODEL=
# Optional: a different model for the quality reviewer. Defaults to OPENAI_MODEL.
OPENAI_REVIEW_MODEL=
# Max AI requests per person per day (each "Write drafts" uses 2). Protects your bill.
AI_DAILY_LIMIT=40

# ---- Facebook ----
# Leave false until you are ready. While false, approved posts are copied and posted by hand, then "Mark as posted".
FB_PUBLISH_ENABLED=false
# Optional: pin a Graph API version from Meta's changelog, e.g. v23.0. Empty = unversioned (Meta picks).
FB_GRAPH_VERSION=
